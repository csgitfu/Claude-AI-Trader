# Required
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890
FRED_API_KEY=...

# Optional / with defaults
STARTING_NAV=1000000
EXECUTE=false                  # shadow mode for first week
KILL_SWITCH=false              # true aborts before any API call
DAILY_BUDGET_USD=25            # abort if a run's estimated spend exceeds this

# Model overrides (IDs can rotate; keep them configurable)
MODEL_SCORER=claude-haiku-4-5-20251001
MODEL_DEBATE=claude-opus-4-7
MODEL_PROBABILITY=claude-opus-4-7
MODEL_SELECTOR=claude-opus-4-7
MODEL_NEWSWRITER=claude-opus-4-7

# Tunables
SHORTLIST_SIZE=50
PORTFOLIO_SIZE=15
MAX_WEIGHT_PER_NAME=0.10
MAX_WEIGHT_PER_SECTOR=0.25
MIN_SECTORS=8
AGENT_CONCURRENCY=5
