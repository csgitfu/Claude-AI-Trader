.env
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Logs are regenerated daily; keep the directory, not its contents
logs/*.jsonl

# Per-run temp fan-out files (deleted after merge); keep committed checkpoints
data/runs/**/scorer_batch_*.json
data/runs/**/debater_*.json
data/runs/**/prob_*.json
# CCR sometimes names temp files with underscore prefix instead of the
# scorer_batch_/debater_/prob_ convention — catch those too
data/runs/**/_*.json
data/runs/**/_*.txt

# Per-machine Claude Code config
.claude/settings.local.json
